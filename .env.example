# Use openai, groq, or ollama.
AI_PROVIDER=ollama
AI_API_KEY=ollama
# Ollama example: gemma3:4b after `ollama pull gemma3:4b`
# Groq example: qwen/qwen3.8-27b
AI_MODEL=
# Optional. Defaults by provider:
# openai → https://api.openai.com/v1
# groq   → https://api.groq.com/openai/v1
# ollama → http://127.0.0.1:11434/v1
AI_BASE_URL=
PORT=3001
